# =========================
# Data
# =========================

# Raw data: downloaded separately, never commit
data/raw/*
!data/raw/.gitkeep

# Intermediate data: generated from raw data
data/interim/*
!data/interim/.gitkeep

# Processed data: generated by the pipeline
data/processed/*
!data/processed/.gitkeep

